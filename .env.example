# Copie para .env (ignorado pelo git) e preencha. Não comite valores reais.
OPENROUTER_API_KEY=
OPENROUTER_MODELO=

# Telemetria (opcional): HARNESS_TELEMETRIA=langfuse envia os traces ao Langfuse Cloud (US).
# HARNESS_TELEMETRIA_CONTEUDO: completo (padrão) ou numeros (só contagens, tokens, custos e tempos).
HARNESS_TELEMETRIA=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_OTLP_ENDPOINT=https://us.cloud.langfuse.com/api/public/otel
HARNESS_TELEMETRIA_CONTEUDO=
